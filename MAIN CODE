// ===================== LOGIN =====================

// Checks the entered username/password against every account in the
// roster. Returns whether a match was found, and copies the matched
// employee's whole record back through loggedIn (passed by reference).
bool login(User users[], int userCount, User &loggedIn) {
    string inputUsername, inputPassword;

    getWord(inputUsername, "Username: ");
    getWord(inputPassword, "Password: ");

    for (int i = 0; i < userCount; i++) {
        if (inputUsername == users[i].username && inputPassword == users[i].password) {
            loggedIn = users[i];
            return true;  // exits immediately; also stops checking further accounts
        }
    }

    return false;  // no account in the whole roster matched
}


