}


// ===================== ADMIN FUNCTIONS =====================

// Shows every employee. Passwords are not shown.
void viewEmployees(const User users[], int userCount) {
    cout << "\n====== EMPLOYEE LIST ======" << endl;
    cout << "[ID] NAME - USERNAME - ROLE" << endl;

    for (int i = 0; i < userCount; i++) {
        cout << "[" << users[i].id << "] "
             << users[i].fullName << " - "
             << users[i].username << " - "
             << users[i].role << endl;
    }
}

void addEmployee(User users[], int &userCount) {
    if (userCount >= MAX_USERS) {
        cout << "Employee list is full! Cannot add more employees.\n";
        return;
    }

    string fullName, username, password, role;
    int roleChoice;
    bool taken;

    cout << "\n====== ADD EMPLOYEE ======" << endl;
    getText(fullName, "Full name: ");

    // Keep asking until the username is not used by anyone else.
    do {
        taken = false;
        getWord(username, "Username (no spaces): ");

        for (int i = 0; i < userCount; i++) {
            if (users[i].username == username) {
                taken = true;
            }
        }

        if (taken) {
            cout << "That username is already taken! Try another one.\n";
        }
    } while (taken);

    getWord(password, "Password (no spaces): ");

    cout << "\nRoles:\n";
    cout << "[1] CASHIER\n";
    cout << "[2] INVENTORY\n";
    cout << "[3] OWNER\n";
    cout << "[4] ADMIN\n";
    getInt(roleChoice, "Select role number: ", 1, 4);

    switch (roleChoice) {
        case 1: role = "CASHIER";   break;
        case 2: role = "INVENTORY"; break;
        case 3: role = "OWNER";     break;
        case 4: role = "ADMIN";     break;
    }

    // The new ID is one higher than the biggest ID that exists.
    int newId = 0;
    for (int i = 0; i < userCount; i++) {
        if (users[i].id > newId) {
            newId = users[i].id;
        }
    }
    newId++;

    users[userCount].id = newId;
    users[userCount].fullName = fullName;
    users[userCount].username = username;
    users[userCount].password = password;
    users[userCount].role = role;
    userCount++;

    cout << "Employee added successfully! Employee ID: " << newId << endl;
}

// myId is the ID of the admin who is logged in (so they can't remove themselves).
void removeEmployee(User users[], int &userCount, int myId) {
    viewEmployees(users, userCount);

    int id;
    char answer;

    getInt(id, "\nEnter the ID of the employee to remove (0 to cancel): ", 0, 999999);

    if (id == 0) {
        cout << "Removal cancelled.\n";
        return;
    }

    // Look for the employee with that ID. index stays -1 if nobody has it.
    int index = -1;
    for (int i = 0; i < userCount; i++) {
        if (users[i].id == id) {
            index = i;
        }
    }

    if (index == -1) {
        cout << "No employee has that ID.\n";
    }
    else if (users[index].id == myId) {
        cout << "You cannot remove your own account while logged in.\n";
    }
    else {
        cout << "You are about to remove: " << users[index].fullName
             << " (" << users[index].role << ")" << endl;
        getYesNo(answer, "Are you sure? (Y/N): ");

        if (answer == 'y' || answer == 'Y') {
            for (int i = index; i < userCount - 1; i++) {
                users[i] = users[i + 1];
            }
            userCount--;

            cout << "Employee removed successfully!\n";
        } else {
            cout << "Removal cancelled.\n";
        }
    }
}


// ===================== ROLE MENUS =====================
// ROLE-BASED ACCESS CONTROL: each role gets its OWN menu, and a menu only
// contains the functions that role is allowed to use. login() tells main()
// which role the account has, and main() sends the user to exactly one menu.
//
//   CASHIER   : view inventory, buy product
//   INVENTORY : view stock, add product, update stock, remove product
//   OWNER     : view inventory, buy product, add product, update stock,
//               change price, view sales
//   ADMIN     : view employees, add employee, remove employee

void cashierMenu(Product products[], int &productCount, double &totalSales, DailySales &daily) {
    int choice;

    do {
        cout << "\n=============================\n";
        cout << "       CASHIER MENU\n";
        cout << "=============================\n";
        cout << "1. View Inventory\n";
        cout << "2. Buy Product\n";
        cout << "3. Logout\n";
        cout << "=============================\n";
        getInt(choice, "Enter choice: ", 1, 3);

        switch (choice) {
            case 1:
                displayInventory(products, productCount);
                break;

            case 2:
                buyProduct(products, productCount, totalSales, daily);
                break;

            case 3:
                // Save on logout: a cashier's purchases change stock and sales.
                saveInventory(products, productCount);
                saveSales(totalSales);
                saveDailySales(daily);
                cout << "\nInventory and sales are now saved!" << endl;
                cout << "Logging out...\n";
                break;
        }
    } while (choice != 3);
}

void inventoryMenu(Product products[], int &productCount) {
    int choice;

    do {
        cout << "\n=============================\n";
        cout << "      INVENTORY MENU\n";
        cout << "=============================\n";
        cout << "1. View Stock\n";
        cout << "2. Add Product\n";
        cout << "3. Update Stock\n";
        cout << "4. Remove Product\n";
        cout << "5. Logout\n";
        cout << "=============================\n";
        getInt(choice, "Enter choice: ", 1, 5);

        switch (choice) {
            case 1:
                displayInventory(products, productCount);
                break;

            case 2:
                addProduct(products, productCount);
                break;

            case 3:
                updateStock(products, productCount);
                break;

            case 4:
                removeProduct(products, productCount);
                break;

            case 5:
                saveInventory(products, productCount);
                cout << "\nInventory is now saved!" << endl;
                cout << "Logging out...\n";
                break;
        }
    } while (choice != 5);
}

// The owner menu has the cashier and inventory options (except Remove
// Product, which is inventory-only), plus Change Price and View Sales.
void ownerMenu(Product products[], int &productCount, double &totalSales, DailySales &daily) {
    int choice;

    do {
        cout << "\n=============================\n";
        cout << "        OWNER MENU\n";
        cout << "=============================\n";
        cout << "1. View Inventory\n";
        cout << "2. Buy Product\n";
        cout << "3. Add Product\n";
        cout << "4. Update Stock\n";
        cout << "5. Change Price\n";
        cout << "6. View Sales\n";
        cout << "7. Logout\n";
        cout << "=============================\n";
        getInt(choice, "Enter choice: ", 1, 7);

        switch (choice) {
            case 1:
                displayInventory(products, productCount);
                break;

            case 2:
                buyProduct(products, productCount, totalSales, daily);
                break;

            case 3:
                addProduct(products, productCount);
                break;

            case 4:
                updateStock(products, productCount);
                break;

            case 5:
                changePrice(products, productCount);
                break;

            case 6:
                viewSales(totalSales);
                break;

            case 7:
                saveInventory(products, productCount);
                saveSales(totalSales);
                saveDailySales(daily);
                cout << "\nInventory and sales are now saved!" << endl;
                cout << "Logging out...\n";
                break;
        }
    } while (choice != 7);
}

